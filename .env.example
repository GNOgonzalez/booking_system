# Copy to .env and fill in. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=booking_dev
DB_USER=booking_user
DB_PASSWORD=devpassword123
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Frontend / CORS ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# --- Email (leave EMAIL_HOST blank to print emails to console) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@booking.local

# --- Stripe (optional; blank = mock payments in DEBUG only) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Production: set Stripe keys above. Mock POST /api/membership/ is blocked when DEBUG=False
# unless you explicitly opt in (testing only — never in real prod):
# ALLOW_MOCK_PAYMENTS=false

# --- Google (optional; blank = placeholder Meet links) ---
# OAuth consent redirect URI must match GOOGLE_REDIRECT_URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/

# --- Studio LLM (optional; staff UI can also store key in DB — prefer env in production) ---
# STUDIO_LLM_API_KEY=

# --- Zoom (optional; blank = placeholder Zoom links) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Production only ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
# JWT lifetimes (defaults: access 60 min; refresh 7 days in DEBUG, 1 day in prod)
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=1
# Override the production Content-Security-Policy header if needed
# CSP_POLICY=
